Table Category {
  id int [pk, increment]
  name varchar(100) [unique]
  description text
}

Table Item {
  id int [pk, increment]
  name varchar(150)
  serial_number varchar(50) [unique]
  category_id int [not null, ref: > Category.id]
  condition varchar(10) [note: 'good / fair / damaged']
  is_available boolean [note: 'computed by the model']
  date_added date
}

Table Borrower {
  id int [pk, increment]
  full_name varchar(150)
  student_id varchar(30) [unique]
  phone varchar(20)
  email varchar(254)
  department varchar(100)
}

Table BorrowRecord {
  id int [pk, increment]
  item_id int [not null, ref: > Item.id]
  borrower_id int [not null, ref: > Borrower.id]
  date_borrowed date
  due_date date
  date_returned date [note: 'null until returned']
  status varchar(10) [note: 'borrowed / returned']
}

Table RiskPrediction {
  id int [pk, increment]
  record_id int [unique, not null, ref: - BorrowRecord.id]
  probability float [note: 'chance of a late return, 0 to 1']
  level varchar(6) [note: 'low / medium / high']
  model_trained_at varchar(20)
  created_at datetime
}